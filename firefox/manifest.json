{
  "manifest_version": 2,
  "name": "Send to Taskwarrior Hardened",
  "version": "0.3.12",
  "description": "Save webpage links to Taskwarrior as tagged bookmark tasks. Hardened fork of shenlebantongying/Taskwarrior-Connector (GPLv3): POST-only, localhost-only, no shell injection.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "taskwarrior-connector@alkaphreak.github",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Send to Taskwarrior Hardened",
    "default_popup": "popup.html",
    "browser_style": false
  },
  "permissions": [
    "activeTab",
    "tabs",
    "http://127.0.0.1/*"
  ]
}
