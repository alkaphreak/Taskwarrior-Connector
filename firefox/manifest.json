{
  "manifest_version": 2,
  "name": "Send to Taskwarrior Hardened",
  "version": "0.3.7",
  "description": "Save webpage links to Taskwarrior as tagged bookmark tasks. Hardened fork of shenlebantongying/Taskwarrior-Connector (GPLv3): POST-only, localhost-only, no shell injection.",
  "icons": {
    "48": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "taskwarrior-connector@alkaphreak.github",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "browser_action": {
    "default_icon": "icon.png",
    "default_title": "Send to Taskwarrior Hardened",
    "default_popup": "popup.html",
    "browser_style": true
  },
  "permissions": [
    "activeTab",
    "tabs",
    "http://127.0.0.1/*"
  ]
}
