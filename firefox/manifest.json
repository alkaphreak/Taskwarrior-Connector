{
  "manifest_version": 2,
  "name": "TaskWarrior Connector",
  "version": "0.3.1",
  "description": "Save webpage links to taskwarrior (hardened fork, POST-only, localhost-only)",
  "icons": {
    "48": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "taskwarrior-connector@alkaphreak.github",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "browser_action": {
    "default_icon": "icon.png",
    "default_title": "Taskwarrior",
    "default_popup": "popup.html",
    "browser_style": true
  },
  "permissions": [
    "activeTab",
    "tabs"
  ]
}
