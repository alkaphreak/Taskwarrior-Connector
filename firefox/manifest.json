{
  "manifest_version": 2,
  "name": "Send to Taskwarrior Hardened",
  "version": "0.5.3",
  "description": "Save the current tab to Taskwarrior as a task, with tags, a project and a note, through a local connector (127.0.0.1 only). Hardened fork of shenlebantongying/Taskwarrior-Connector (GPLv3).",
  "author": "Alkaphreak",
  "homepage_url": "https://github.com/alkaphreak/Taskwarrior-Connector",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "taskwarrior-connector@alkaphreak.github",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Send to Taskwarrior Hardened",
    "default_popup": "popup.html",
    "browser_style": false
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "http://127.0.0.1/*"
  ],
  "options_ui": {
    "page": "options.html"
  }
}
